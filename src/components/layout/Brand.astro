---
/**
 * Brand — the PSoAR logo.
 *   tone="light" (header): the winged PSoAR wordmark.
 *   tone="dark"  (footer): the round "Psychedelic Society of Arkansas" seal.
 *
 * The images are decorative (alt=""): the link around them carries the
 * organization's name for screen readers.
 * Logo files live in src/assets/brand/.
 */
import { Image } from 'astro:assets';
import wordmark from '../../assets/brand/psoar-wordmark.webp';
import seal from '../../assets/brand/psoar-seal.svg';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
---

{
  tone === 'light' ? (
    <Image src={wordmark} alt="" height={36} densities={[1, 2, 3]} class="wordmark" loading="eager" />
  ) : (
    <img src={seal.src} alt="" width="104" height="104" class="seal" loading="lazy" decoding="async" />
  )
}

<style>
  .wordmark {
    height: 36px;
    width: auto;
  }
  @media (max-width: 400px) {
    .wordmark {
      height: 30px;
    }
  }
  .seal {
    width: 104px;
    height: 104px;
  }
</style>
