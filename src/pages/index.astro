---
/**
 * Home page. Address: /
 * Sections, top to bottom: hero (with the next event), upcoming events, latest
 * newsletter issue, what we're about, chapters, featured reading, partners, get involved.
 */
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Clock from '@lucide/astro/icons/clock';
import MapPin from '@lucide/astro/icons/map-pin';
import Sprout from '@lucide/astro/icons/sprout';
import HeartHandshake from '@lucide/astro/icons/heart-handshake';
import BookOpen from '@lucide/astro/icons/book-open';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Ridges from '../components/ui/Ridges.astro';
import EventList from '../components/events/EventList.astro';
import SubscribeLinks from '../components/events/SubscribeLinks.astro';
import ArticleCards from '../components/sections/ArticleCards.astro';
import NewsletterPosts from '../components/sections/NewsletterPosts.astro';
import GetInvolved from '../components/sections/GetInvolved.astro';
import Partners from '../components/sections/Partners.astro';
import Chapters from '../components/sections/Chapters.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/photos/ozarks-sunset.avif';
import { endsAt, getEvents, startParts, whenText } from '../lib/events';
import { articles } from '../data/articles';
import { pillars } from '../data/about';
import { SITE } from '../config/site';

const events = getEvents();
const next = events[0];
const nextDate = next && startParts(next);
const featured = articles.filter((a) => a.featured).slice(0, 3);
const pillarIcons = { mission: Sprout, vision: HeartHandshake, purpose: BookOpen };
---

<BaseLayout>
  <section class="hero on-dark" aria-labelledby="hero-title">
    <Image
      src={heroPhoto}
      alt=""
      class="hero-photo"
      widths={[720, 1080, 1440]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Psychedelic Society of Arkansas</p>
        <h1 id="hero-title">Find the others.</h1>
        <p class="hero-lede">
          We promote education, risk reduction, and community outreach in the area of psychedelics and plant medicine
          across Arkansas.
        </p>
        <p class="say">Pronounced “soar.” The P is silent.</p>
        <div class="hero-actions">
          <Button href="#events">See upcoming events</Button>
          <Button href={SITE.newsletterUrl} variant="light" external>Subscribe to the newsletter</Button>
        </div>
      </div>

      <div class="next-wrap">
        {
          next && (
            <a class="next" href="#events" data-next-event data-ends={endsAt(next)}>
              <span class="next-label">Next up</span>
              <span class="next-row">
                <span class="next-date" aria-hidden="true">
                  <span>{nextDate!.month}</span>
                  <span class="next-day">{nextDate!.day}</span>
                </span>
                <span class="next-title">{next.title}</span>
              </span>
              <span class="sr-only">{nextDate!.full}, </span>
              <span class="next-meta">
                <Clock size={15} aria-hidden="true" /> {nextDate!.weekday}, {whenText(next)}
              </span>
              {next.location && (
                <span class="next-meta">
                  <MapPin size={15} aria-hidden="true" /> {next.location}
                </span>
              )}
              <span class="next-more">
                All upcoming events <ArrowRight size={16} aria-hidden="true" />
              </span>
            </a>
          )
        }
        <!-- Shown when there's no next event (or it has ended since the last update). -->
        <a class="next" href="#events" data-next-fallback hidden={!!next}>
          <span class="next-label">Our calendar</span>
          <span class="next-title">Education nights and community gatherings across Arkansas.</span>
          <span class="next-more">
            See what’s coming up <ArrowRight size={16} aria-hidden="true" />
          </span>
        </a>
      </div>
    </div>
    <Ridges />
  </section>

  <Section id="events" labelledby="events-heading" padTop={false}>
    <SectionHeading
      id="events-heading"
      eyebrow="Calendar"
      title="Upcoming events"
      link={{ href: '/events', label: 'All events' }}
    />
    <EventList events={events} limit={4} compact />
    <div class="subscribe-row">
      <SubscribeLinks />
    </div>
  </Section>

  <Section tone="alt" labelledby="newsletter-heading">
    <SectionHeading
      id="newsletter-heading"
      eyebrow="Newsletter"
      title="Latest from our Substack"
      link={{ href: SITE.newsletterUrl, label: 'All posts', external: true }}
    />
    <NewsletterPosts />
  </Section>

  <Section labelledby="about-heading">
    <SectionHeading
      id="about-heading"
      eyebrow="Who we are"
      title="What we’re about"
      link={{ href: '/about', label: 'About PSoAR' }}
    />
    <ul class="pillars" role="list">
      {
        pillars.map((p) => {
          const Icon = pillarIcons[p.id];
          return (
            <li class="pillar">
              <span class="pillar-icon">
                <Icon size={24} aria-hidden="true" />
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          );
        })
      }
    </ul>
  </Section>

  <Chapters tone="alt" />


  <Section tone="tint" labelledby="reading-heading">
    <SectionHeading
      id="reading-heading"
      eyebrow="Featured reading"
      title="Psychedelic news & research"
      link={{ href: '/reading', label: 'Full reading list' }}
    >
      <p>
        Explore the latest on the benefits of entheogenic plants and fungi, from mental health breakthroughs to
        spiritual well-being.
      </p>
    </SectionHeading>
    <ArticleCards articles={featured} />
  </Section>

  <Partners />

  <GetInvolved />
</BaseLayout>

<script>
  // If the "Next up" event has ended since the site was last built, show the general card instead.
  const card = document.querySelector<HTMLElement>('[data-next-event]');
  if (card && Number(card.dataset.ends) <= Date.now()) {
    card.hidden = true;
    document.querySelector<HTMLElement>('[data-next-fallback]')?.removeAttribute('hidden');
  }
</script>

<style>
  /* --- Hero ------------------------------------------------------------ */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--sunset);
    padding-top: clamp(56px, 8vw, 112px);
    padding-bottom: clamp(120px, 16vw, 220px);
  }
  /* The Ozarks sunset photo in its own colours, with a soft shade on the left
     and top so the white text stays readable. */
  .hero :global(.hero-photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(0.9);
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(25, 25, 25, 0.78) 0%, rgba(25, 25, 25, 0.45) 50%, rgba(25, 25, 25, 0.12) 100%),
      linear-gradient(180deg, rgba(25, 25, 25, 0.45) 0%, rgba(25, 25, 25, 0) 45%, rgba(25, 25, 25, 0.35) 100%);
  }
  @media (max-width: 959px) {
    .hero-shade {
      background: linear-gradient(180deg, rgba(25, 25, 25, 0.7) 0%, rgba(25, 25, 25, 0.55) 60%, rgba(25, 25, 25, 0.4) 100%);
    }
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .hero-text {
    display: grid;
    gap: 18px;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(46px, 7.4vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .hero-lede {
    font-size: clamp(18px, 1.6vw, 21px);
    max-width: 40ch;
    color: #fff;
  }
  .say {
    font-size: 15px;
    font-style: italic;
    color: var(--on-dark-subtle);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .next[hidden] {
    display: none;
  }
  .next {
    display: grid;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: rgba(15, 18, 23, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--on-dark);
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .next:hover {
    border-color: rgba(241, 150, 119, 0.8);
    color: var(--on-dark);
    transform: translateY(-2px);
  }
  .next-label {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .next-row {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .next-date {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 62px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }
  .next-day {
    font-size: 26px;
    letter-spacing: 0;
    margin-top: 3px;
  }
  .next-title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 21px;
    line-height: 1.2;
    color: #fff;
  }
  .next-meta {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-size: 15px;
  }
  .next-meta :global(svg) {
    flex: none;
    position: relative;
    top: 2px;
    color: var(--accent);
  }
  .next-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-weight: 500;
    color: var(--accent);
  }

  /* --- Events ---------------------------------------------------------- */
  .subscribe-row {
    margin-top: 24px;
  }

  /* --- Pillars --------------------------------------------------------- */
  .pillars {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 800px) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }
  .pillar {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 26px;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .pillar-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--accent);
    color: var(--on-accent);
  }
  .pillar h3 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 21px;
    color: var(--ink);
  }
  .pillar p {
    color: var(--text);
  }
</style>
