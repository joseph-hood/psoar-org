---
/**
 * GetInvolved — dark band with the ways to take part. Used on Home and About.
 */
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Newspaper from '@lucide/astro/icons/newspaper';
import Users from '@lucide/astro/icons/users';
import ShoppingBag from '@lucide/astro/icons/shopping-bag';
import Mail from '@lucide/astro/icons/mail';
import { SITE } from '../../config/site';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const ways = [
  {
    icon: Newspaper,
    title: 'Read the newsletter',
    text: 'Event announcements, community news, and reflections from Arkansas and beyond.',
    href: SITE.newsletterUrl,
    external: true,
  },
  {
    icon: Users,
    title: 'Start a chapter',
    text: 'Bring education nights and community gatherings to your corner of Arkansas.',
    href: SITE.chapterFormUrl,
    external: true,
  },
  {
    icon: ShoppingBag,
    title: 'Visit the PStore',
    text: 'PSoAR merch, printed on demand. Every purchase supports our work.',
    href: SITE.storeUrl,
    external: true,
  },
  {
    icon: Mail,
    title: 'Get in touch',
    text: 'Questions, ideas, or want to help out? We’d love to hear from you.',
    href: '/contact',
    external: false,
  },
];
---

<Section tone="night" labelledby="involved-heading">
  <SectionHeading id="involved-heading" eyebrow="Get involved" title="Join the community" />
  <ul class="ways" role="list">
    {
      ways.map(({ icon: Icon, title, text, href, external }) => (
        <li class="way">
          <Icon size={26} aria-hidden="true" class="icon" />
          <h3 class="title">
            <a href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
              {title}
              {external && <span class="sr-only"> (opens in a new tab)</span>}
            </a>
          </h3>
          <p>{text}</p>
          {external ? (
            <ArrowUpRight size={18} aria-hidden="true" class="arrow" />
          ) : (
            <ArrowRight size={18} aria-hidden="true" class="arrow" />
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .ways {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .ways {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .ways {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .way {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }
  .way:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(241, 150, 119, 0.6);
  }
  .way:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .way :global(.icon) {
    color: var(--salmon);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 19px;
    color: #fff;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .way p {
    font-size: 15.5px;
    color: var(--on-dark-subtle);
    flex: 1;
  }
  .way :global(.arrow) {
    color: var(--salmon);
  }
</style>
