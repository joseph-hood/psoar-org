---
/**
 * NewsletterPosts — the newsletter on the home page. Uses, in order:
 *  1. the latest posts downloaded from Substack, when the download works;
 *  2. otherwise the latest post's Substack embed, from src/data/latest-substack.html
 *     (paste the new embed code there each month);
 *  3. otherwise a "Read the newsletter" prompt.
 */
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import { getLatestEmbed, getNewsletterPosts, postDate } from '../../lib/newsletter';
import { SITE } from '../../config/site';
import Button from '../ui/Button.astro';

const posts = getNewsletterPosts(3);
const embed = posts.length ? null : getLatestEmbed();
---

{
  posts.length > 0 ? (
    <ul class="posts" role="list">
      {posts.map((post) => (
        <li class="post">
          {post.image && (
            <img class="cover" src={post.image} alt="" loading="lazy" decoding="async" width="600" height="315" />
          )}
          <div class="text">
            <p class="date">{postDate(post)}</p>
            <h3 class="title">
              <a href={post.url} target="_blank" rel="noopener">
                {post.title}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </h3>
            {post.summary && <p class="summary">{post.summary}</p>}
            <p class="read">
              Read on Substack <ArrowUpRight size={15} aria-hidden="true" />
            </p>
          </div>
        </li>
      ))}
    </ul>
  ) : embed ? (
    <div class="latest">
      <div class="embed" set:html={embed.html} />
      <div class="latest-side">
        <p class="eyebrow">Latest issue</p>
        <p>
          A new issue goes out each month. Subscribe on Substack to get it in your inbox.
        </p>
        <div class="latest-actions">
          <Button href={SITE.newsletterUrl} external>
            Subscribe
          </Button>
          <Button href={`${SITE.newsletterUrl.replace(/\/$/, '')}/archive`} variant="outline" external>
            Past issues
          </Button>
        </div>
      </div>
      <script is:inline async src="https://substack.com/embedjs/embed.js" charset="utf-8"></script>
    </div>
  ) : (
    <div class="fallback">
      <p>News, event recaps, and reflections from our community, delivered to your inbox.</p>
      <Button href={SITE.newsletterUrl} external>
        Read the newsletter
      </Button>
    </div>
  )
}

<style>
  .posts {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 800px) {
    .posts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .post {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .cover {
    aspect-ratio: 1200 / 630;
    width: 100%;
    object-fit: cover;
    background: var(--surface-2);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
    flex: 1;
  }
  .date {
    font-size: 13.5px;
    color: var(--text-subtle);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 20px;
    line-height: 1.25;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:focus-visible {
    outline: none;
  }
  .post:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .post:hover .title a {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .summary {
    font-size: 15.5px;
    color: var(--text);
    flex: 1;
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 500;
    color: var(--link);
  }
  /* Latest-issue embed. Substack's script swaps the <div> for its own card (an
     iframe); until then, or without JavaScript, the title, blurb and link show. */
  .latest {
    display: grid;
    gap: 24px 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .latest {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }
  .embed {
    min-width: 0;
  }
  .embed :global(.substack-post-embed) {
    display: grid;
    gap: 10px;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
  }
  .embed :global(.substack-post-embed p:first-child) {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 20px;
    line-height: 1.25;
    color: var(--ink);
  }
  .embed :global(.substack-post-embed a) {
    font-weight: 500;
  }
  .embed :global(iframe) {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
    border-radius: var(--radius-lg);
  }
  .latest-side {
    display: grid;
    gap: 14px;
    color: var(--text);
  }
  .latest-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    padding: 28px;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--text);
  }
</style>
