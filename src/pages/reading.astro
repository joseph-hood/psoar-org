---
/**
 * Reading list. Address: /reading
 * Articles live in src/data/articles.ts, grouped here by topic. The old
 * psoar.org article addresses forward to this page.
 */
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ArticleCards from '../components/sections/ArticleCards.astro';
import { articles, topics } from '../data/articles';

const featured = articles.filter((a) => a.featured).slice(0, 3);
const groups = topics
  .map((topic) => ({ topic, id: topic.toLowerCase().replace(/[^a-z]+/g, '-'), list: articles.filter((a) => a.topic === topic) }))
  .filter((g) => g.list.length);
---

<BaseLayout
  title="Reading"
  description="Articles on psychedelic research, plant medicine, and policy, collected by the Psychedelic Society of Arkansas."
>
  <PageHeader eyebrow="Reading" title="Psychedelic news & research">
    <p>Articles we think are worth your time, on research, plant medicine traditions, and drug policy.</p>
  </PageHeader>

  <Section padTop={false} labelledby="featured-heading">
    <SectionHeading id="featured-heading" eyebrow="Start here" title="Featured" />
    <ArticleCards articles={featured} />
  </Section>

  <Section tone="alt" labelledby="all-heading">
    <SectionHeading id="all-heading" eyebrow="Archive" title="By topic" />
    <nav class="jump" aria-label="Topics">
      {groups.map((g) => <a href={`#${g.id}`}>{g.topic} <span class="count">{g.list.length}</span></a>)}
    </nav>

    {
      groups.map((g) => (
        <section class="topic" id={g.id} aria-labelledby={`${g.id}-heading`}>
          <h3 id={`${g.id}-heading`} class="topic-title">
            {g.topic}
          </h3>
          <ul class="list" role="list">
            {g.list.map((article) => (
              <li class="item">
                <a href={article.url} target="_blank" rel="noopener">
                  <span class="item-title">
                    {article.title}
                    <ArrowUpRight size={15} aria-hidden="true" />
                  </span>
                  <span class="item-source">{article.source}</span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
                <p class="item-summary">{article.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </Section>
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .jump a:hover {
    border-color: var(--ink);
  }
  .count {
    font-size: 12.5px;
    color: var(--text-subtle);
  }

  .topic {
    padding-top: 32px;
  }
  .topic-title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-ink);
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .list {
    display: grid;
  }
  @media (min-width: 900px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 40px;
    }
  }
  .item {
    display: grid;
    gap: 6px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  .item a {
    display: grid;
    gap: 2px;
    text-decoration: none;
  }
  .item-title {
    font-weight: 500;
    font-size: 17px;
    line-height: 1.35;
    color: var(--ink);
  }
  .item-title :global(svg) {
    display: inline;
    vertical-align: -2px;
    margin-left: 4px;
    color: var(--accent-ink);
  }
  .item a:hover .item-title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .item-source {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-subtle);
  }
  .item-summary {
    font-size: 15px;
    color: var(--text);
  }
</style>
