---
/**
 * Mark — the round sunset-over-the-Ozarks badge used as the logo icon.
 *
 * TODO(logo): stand-in drawn in code until the real PSoAR icon files are added
 * (icon_dark_bg_512.png / icon2_circle_512.png from the old site). Swap this
 * component's contents for an <Image> of the real icon then.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 44, class: className } = Astro.props;
// Unique ids so several marks on one page don't share a gradient by accident.
const id = `mark-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class={className} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2c2a3d"></stop>
      <stop offset="0.45" stop-color="#9183a4"></stop>
      <stop offset="0.7" stop-color="#ef8994"></stop>
      <stop offset="1" stop-color="#f19677"></stop>
    </linearGradient>
    <clipPath id={`${id}-clip`}><circle cx="32" cy="32" r="32"></circle></clipPath>
  </defs>
  <g clip-path={`url(#${id}-clip)`}>
    <rect width="64" height="64" fill={`url(#${id}-sky)`}></rect>
    <circle cx="32" cy="41" r="13" fill="#fde2c8" opacity="0.92"></circle>
    <path d="M0 44 C10 37 17 40 25 35 C33 30 40 37 48 33 C55 30 60 33 64 31 V64 H0 Z" fill="#253925"></path>
    <path d="M0 52 C9 47 18 50 28 46 C38 42 46 49 56 46 C60 45 62 45 64 44 V64 H0 Z" fill="#131d13"></path>
  </g>
</svg>
