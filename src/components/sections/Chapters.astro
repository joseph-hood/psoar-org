---
/**
 * Chapters — each local chapter's seal, location and Facebook link, plus a
 * "Start a chapter" prompt. Data: src/data/chapters.ts.
 * The chapter seals are the one place the ringed seal is used on the site.
 */
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import MapPin from '@lucide/astro/icons/map-pin';
import Mail from '@lucide/astro/icons/mail';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { chapters } from '../../data/chapters';
import { SITE } from '../../config/site';
import bentonville from '../../assets/chapters/bentonville.webp';
import fayetteville from '../../assets/chapters/fayetteville.webp';
import eurekaSprings from '../../assets/chapters/eureka-springs.webp';
import centralArkansas from '../../assets/chapters/central-arkansas.webp';

interface Props {
  tone?: 'default' | 'alt';
}
const { tone = 'default' } = Astro.props;

const seals = {
  bentonville,
  fayetteville,
  'eureka-springs': eurekaSprings,
  'central-arkansas': centralArkansas,
};
---

<Section tone={tone} labelledby="chapters-heading">
  <SectionHeading
    id="chapters-heading"
    eyebrow="Chapters"
    title="Find your local chapter"
    link={{ href: SITE.chapterFormUrl, label: 'Start a chapter', external: true }}
  >
    <p>PSoAR meets in communities across Arkansas. Join the chapter nearest you.</p>
  </SectionHeading>

  <ul class="chapters" role="list">
    {
      chapters.map((c) => (
        <li class="chapter">
          <Image
            src={seals[c.id]}
            alt={`Psychedelic Society of Arkansas, ${c.name} chapter seal`}
            width={150}
            height={150}
            densities={[1, 2]}
            class="seal"
          />
          <h3 class="name">{c.name}</h3>
          {c.note && <p class="note">{c.note}</p>}
          <p class="location">
            <MapPin size={15} aria-hidden="true" /> {c.location}
          </p>
          <a class="email" href={`mailto:${c.email}`}>
            <Mail size={15} aria-hidden="true" /> {c.email}
          </a>
          {c.facebook ? (
            <a class="fb" href={c.facebook} target="_blank" rel="noopener">
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.43-4.92 8.43-9.94Z" />
              </svg>
              Facebook
              <ArrowUpRight size={14} aria-hidden="true" />
              <span class="sr-only"> ({c.name} chapter, opens in a new tab)</span>
            </a>
          ) : (
            <p class="soon">Facebook page coming soon</p>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .chapters {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 560px) {
    .chapters {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 960px) {
    .chapters {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
  }
  .chapter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px 16px;
    text-align: center;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  :global(.section--alt) .chapter {
    background: var(--surface-2);
  }
  .chapter :global(.seal) {
    width: min(150px, 100%);
    height: auto;
    aspect-ratio: 1;
    border-radius: 999px;
    margin-bottom: 6px;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 20px;
    color: var(--ink);
  }
  .note {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  .location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    color: var(--text);
  }
  .location :global(svg) {
    color: var(--accent-ink);
  }
  .email {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    font-size: 14.5px;
    overflow-wrap: anywhere;
    margin-bottom: 4px;
  }
  .email :global(svg) {
    flex: none;
  }
  .fb {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .fb:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .soon {
    margin-top: auto;
    padding: 7px 0;
    font-size: 14px;
    color: var(--text-subtle);
  }
</style>
