---
/**
 * Footer — dark band at the bottom of every page: about blurb, links, contact,
 * and the 501(c)(3) notice. Header links come from src/data/nav.ts; the
 * "Get involved" links are listed here.
 */
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Mail from '@lucide/astro/icons/mail';
import { mainNav } from '../../data/nav';
import { SITE } from '../../config/site';
import { partners } from '../../data/partners';
import Brand from './Brand.astro';

const involved = [
  { label: 'Newsletter', href: SITE.newsletterUrl, external: true },
  { label: 'Start a chapter', href: SITE.chapterFormUrl, external: true },
  { label: 'PStore', href: SITE.storeUrl, external: true },
  { label: 'Contact us', href: '/contact', external: false },
];
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="top">
      <div class="about">
        <a class="brand-link" href="/" aria-label="Psychedelic Society of Arkansas, home">
          <Brand tone="dark" />
        </a>
        <p>Education, risk reduction, and community outreach around psychedelics and plant medicine in Arkansas.</p>
        <div class="social">
          <a href={SITE.facebookUrl} target="_blank" rel="noopener" aria-label="PSoAR on Facebook (opens in a new tab)">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path
                d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.43-4.92 8.43-9.94Z"
              ></path>
            </svg>
          </a>
          <a href={`mailto:${SITE.email}`} aria-label={`Email ${SITE.email}`}><Mail size={20} /></a>
        </div>
      </div>

      <nav aria-label="Footer" class="col">
        <h2 class="col-title">Explore</h2>
        <ul role="list">
          <li><a href="/">Home</a></li>
          {
            mainNav.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="col">
        <h2 class="col-title">Get involved</h2>
        <ul role="list">
          {
            involved.map((link) =>
              link.external ? (
                <li>
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.label}
                    <ArrowUpRight size={14} aria-hidden="true" />
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              ) : (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ),
            )
          }
        </ul>
      </div>

      <div class="col">
        <h2 class="col-title">Partners</h2>
        <ul role="list">
          {
            partners.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener">
                  {p.name}
                  <ArrowUpRight size={14} aria-hidden="true" />
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
        <h2 class="col-title reach">Reach out</h2>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
    </div>

    <div class="bottom">
      <p>© {year} Psychedelic Society of Arkansas</p>
      <p>
        The Psychedelic Society of Arkansas is a 501(c)(3) nonprofit organization. EIN {SITE.ein}. Nothing on this site
        is medical or legal advice.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--night);
    padding-block: clamp(48px, 6vw, 72px) 32px;
    font-size: 15.5px;
  }
  .top {
    display: grid;
    gap: 36px;
  }
  @media (min-width: 720px) {
    .top {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .top {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
    .about {
      grid-column: auto;
    }
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 36ch;
  }
  .about :global(.seal) {
    width: 112px;
    height: 112px;
  }
  .about p {
    color: var(--on-dark-subtle);
  }
  .brand-link {
    display: inline-flex;
    align-self: flex-start;
    text-decoration: none;
    border-radius: var(--radius);
  }
  .social {
    display: flex;
    gap: 10px;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
  }
  .social a:hover {
    border-color: var(--salmon);
    color: var(--salmon);
  }

  .col-title {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--salmon);
    margin-bottom: 14px;
  }
  .col ul {
    display: grid;
    gap: 8px;
  }
  .reach {
    margin-top: 28px;
  }
  .col a {
    color: var(--on-dark);
    text-decoration: none;
  }
  .col a :global(svg) {
    display: inline;
    vertical-align: -1px;
    margin-left: 4px;
  }
  .col a:hover {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: var(--salmon);
  }

  .bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    font-size: 13.5px;
    color: var(--on-dark-subtle);
  }
  .bottom p:last-child {
    max-width: 70ch;
  }
</style>
